# ==== 二进制 / 构建产物 / 安装器（仅根目录，forge-src 内的构建依赖 jar 保留） ====
/*.jar
/*.exe
*.class
*.pyc
__pycache__/
/Uninstaller/

# ==== 敏感信息兜底（防误提交密钥/凭据；2026-08-15 安全审计新增） ====
*.pem
*.key
*.p12
*.pfx
*.jks
*.keystore
.env
.env.*
!.env.example
id_rsa
id_rsa.pub
id_ed25519
id_ed25519.pub
*.git-credentials
.netrc
.htpasswd
secrets.*
secret.*.json

# ==== 本地小工具（不入库） ====
/推送.cmd

# ==== 根目录：原项目安装器文件与 AGENT 工作记录（不入库） ====
/CHANGES.txt
/ISSUES.txt
/INSTALLATION.txt
/build.txt
/.installationinformation
/AGENTS.md
/session-log.md
/verification-todo.md
/forge*.cmd
/forge*.sh
/forge*.command
/forge-adventure.*
/adventure-editor.*
/forge.profile.properties.example
/docs/

# ==== res/ 下：只跟踪本项目产出与官方卡牌脚本相关 ====
res/*
!res/cardsfolder/
!res/tokenscripts/
!res/editions/
!res/lists/
!res/blockdata/
!res/pics/
!res/gbf-pics/
!res/gbf-pics/**

# cardsfolder：GBF 136 卡 + 官方脚本 zip 全量入库
res/cardsfolder/*.zip
!res/cardsfolder/cardsfolder.zip

# tokenscripts / editions / lists / blockdata：官方全量（含 GBF 修改）
res/tokenscripts/*
!res/tokenscripts/*.txt
res/editions/*
!res/editions/*.txt
res/lists/*
!res/lists/*.txt
res/blockdata/*
!res/blockdata/*.txt

# pics：GBF 卡图（Forge 不会自动下载自定义集卡图，随仓库分发）
res/pics/*
!res/pics/cards/
res/pics/cards/*
!res/pics/cards/GBF/

# custom-cards：设计稿（本地设计输入，不入库）
res/custom-cards/

